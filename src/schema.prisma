generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
/*// ==========================================
// COURIER PLATFORM LEBANON
// PostgreSQL -> DBML ->PRISMA
// ==========================================

// ========== ENUM TYPES ==========*/

enum AuditOutcome {
  ok
  denied
  failed

  @@map("audit_outcome")
}

enum BusinessCategory {
  online_shop
  supermarket
  fruit_vegetables
  cosmetics
  fashion
  phones_electronics
  optics
  tools_hardware
  sanitary_ware
  textiles
  flowers_gifts
  car_rental
  industry
  other

  @@map("business_category")
}

enum BusinessStatus {
  active
  inactive
  prospect

  @@map("business_status")
}

enum BusinessType {
  shop
  orders

  @@map("business_type")
}

enum CancelReason {
  client_asked
  client_unreachable
  duplicate
  wrong_details
  no_rider
  other
  client_declined

  @@map("cancel_reason")
}

enum CashDirection {
  from_rider
  to_rider

  @@map("cash_direction")
}

enum ClientSource {
  whatsapp
  instagram
  facebook
  tiktok
  website
  indrive
  through_business
  referral
  other

  @@map("client_source")
}

enum ClientStatus {
  active
  inactive
  do_not_deliver
  blocked

  @@map("client_status")
}

enum CodPolicy {
  yes
  no
  sometimes

  @@map("cod_policy")
}

enum ConversationMode {
  bot
  human

  @@map("conversation_mode")
}

enum DeliveryTime {
  morning
  afternoon
  evening
  any

  @@map("delivery_time")
}

enum Gender {
  female
  male

  @@map("gender")
}

enum ImportIssue {
  no_name
  location_unknown
  zone_unclear
  unusual_number
  duplicate_phone

  @@map("import_issue")
}

enum Language {
  ar
  en
  fr

  @@map("language")
}

enum OrderStatus {
  quote
  new
  assigned
  picked_up
  delivered
  failed
  cancelled

  @@map("order_status")
}

enum ParcelSize {
  S
  M
  L

  @@map("parcel_size")
}

enum PausedBy {
  bot
  staff

  @@map("paused_by")
}

enum PaymentMethod {
  cod_usd
  cod_lbp
  whish
  omt
  card
  bank_transfer

  @@map("payment_method")
}

enum PhoneKind {
  mobile
  landline
  international
  unverified

  @@map("phone_kind")
}

enum ProofKind {
  delivered
  failed

  @@map("proof_kind")
}

enum ServiceType {
  package
  errand

  @@map("service_type")
}

enum SettlementFrequency {
  daily
  weekly
  biweekly
  monthly

  @@map("settlement_frequency")
}

enum SettlementMethod {
  cash
  whish
  omt
  bank_transfer

  @@map("settlement_method")
}

enum ShiftEndedBy {
  rider
  staff

  @@map("shift_ended_by")
}
/* // ==========================================
// 1. AUTHENTICATION AND USERS
// ==========================================*/

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires") @db.Timestamptz(6)

  Accounts Account[]
  sessions Session[]
  businessMembers BusinessMember[]
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 

  @@index([userId], map: "accounts_user_idx")
  @@map("accounts")
}


model Session {
  id             String    @id
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  token          String    @unique
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  userId         String    @map("user_id")
  impersonatedBy String?   @map("impersonated_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_idx")
  @@map("sessions")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "verifications_identifier_idx")
  @@map("verifications")
}
/*// ==========================================
// 2. GEOGRAPHICAL DATA
// ==========================================*/


model Zone {
  code String @id
  name String
  geom Unsupported("geometry(MultiPolygon,4326)")

  @@map("zones")
}



model Area {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  district    String
  governorate String
  zone        String?

  @@map("areas")
}



model Address {
  id         Int      @id @default(autoincrement())
  clientId   Int      @map("client_id")
  lat        Float    @db.DoublePrecision
  lng        Float    @db.DoublePrecision
  zone       String?
  placeName  String?  @map("place_name")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  label      String?
  building   String?
  floor      String?
  apartment  String?
  landmark   String?
  instructions String?

  @@map("addresses")
}
/*
// ==========================================
// 3. CLIENTS
// ==========================================*/





model Client {
  id                Int           @id @default(autoincrement())
  waId              String        @unique @map("wa_id")
  name              String?
  profileName       String?       @map("profile_name")
  source            ClientSource?
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  title             String?
  firstName         String?       @map("first_name")
  lastName          String?       @map("last_name")
  gender            Gender?
  language          Language?
  status            ClientStatus  @default(active)
  areaId            Int?          @map("area_id")
  preferredTime     DeliveryTime? @map("preferred_time")
  preferredPayment  PaymentMethod? @map("preferred_payment")
  marketingConsent  Boolean?      @map("marketing_consent")
  marketingConsentAt DateTime?    @map("marketing_consent_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  nameConfirmedAt   DateTime?     @map("name_confirmed_at") @db.Timestamptz(6)
  erasedAt          DateTime?     @map("erased_at") @db.Timestamptz(6)

  clientPhones ClientPhone[]

  @@index([areaId], map: "clients_area_idx")
  @@map("clients")
}



model ClientPhone {
  id        Int       @id @default(autoincrement())
  clientId  Int       @map("client_id")
  phone     String    @unique(map: "client_phones_phone_uq")
  kind      PhoneKind
  isPrimary Boolean   @default(false) @map("is_primary")
  label     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId], map: "client_phones_client_idx")
  @@map("client_phones")
}



model Conversation {
  waId          String           @id @map("wa_id")
  mode           ConversationMode @default(bot)
  humanUntil     DateTime?        @map("human_until") @db.Timestamptz(6)
  state          String           @default("idle")
  draft          Json             @default("{}") @db.JsonB
  lastInboundAt  DateTime?        @map("last_inbound_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  pausedBy       PausedBy?        @map("paused_by")

  @@map("conversations")
}

// ==========================================
// 4. BUSINESSES
// ==========================================


model Business {
  id        Int            @id @default(autoincrement())
  name      String
  type      BusinessType
  category  BusinessCategory?
  status    BusinessStatus  @default(active)
  areaId    Int?            @map("area_id")
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  contacts  BusinessContact[]
  locations BusinessLocation[]
  members   BusinessMember[]
  terms     BusinessTerms?

  @@map("businesses")
}



model BusinessContact {
  id         Int       @id @default(autoincrement())
  businessId Int       @map("business_id")
  name       String?
  role       String?
  phone      String
  phoneKind  PhoneKind @map("phone_kind")
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId], map: "business_contacts_business_idx")
  @@index([phone], map: "business_contacts_phone_idx")
  @@map("business_contacts")
}



model BusinessLocation {
  id           Int       @id @default(autoincrement())
  businessId   Int       @map("business_id")
  label        String?
  lat          Float?    @db.DoublePrecision
  lng          Float?    @db.DoublePrecision
  zone         String?
  areaId       Int?      @map("area_id")
  building     String?
  floor        String?
  landmark     String?
  openingHours String?   @map("opening_hours")
  pickupWindow String?   @map("pickup_window")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([id, businessId], map: "business_locations_id_business_uq")
  @@index([businessId], map: "business_locations_business_idx")
  @@map("business_locations")
}



model BusinessMember {
  userId     String   @id @map("user_id")
  businessId Int      @map("business_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId], map: "business_members_business_idx")
  @@map("business_members")
}



 


model BusinessTerms {
  businessId              Int                  @id @map("business_id")
  ratePerOrderUsd         Decimal?             @map("rate_per_order_usd") @db.Decimal(8, 2)
  collectsCod             CodPolicy?           @map("collects_cod")
  settlementFrequency     SettlementFrequency? @map("settlement_frequency")
  settlementMethod        SettlementMethod?    @map("settlement_method")
  startedOn               DateTime?            @map("started_on") @db.Date
  expectedOrdersPerWeek   Int?                  @map("expected_orders_per_week")
  typicalParcelSize       ParcelSize?           @map("typical_parcel_size")
  updatedAt               DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_terms")
}


// ==========================================
// 5. ORDERS AND DISPATCH
// ==========================================



model OrderBatch {
  id              Int      @id @default(autoincrement())
  businessId      Int      @map("business_id")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  idempotencyKey  String?  @map("idempotency_key")// to prevent duplicate orders

  @@index([businessId, createdAt], map: "order_batches_business_idx")
  @@unique([id, businessId], map: "order_batches_id_business_uq")
  @@unique([businessId, idempotencyKey], map: "order_batches_idempotency_uq")
  @@map("order_batches")
}

model Order {
  id                Int          @id @default(autoincrement())
  clientId          Int?         @map("client_id")
  service           ServiceType
  status            OrderStatus  @default(new)
  pickupLat         Float?       @map("pickup_lat") @db.DoublePrecision
  pickupLng         Float?       @map("pickup_lng") @db.DoublePrecision
  pickupZone        String?      @map("pickup_zone")
  pickupDetails     String?      @map("pickup_details")
  dropoffLat        Float?       @map("dropoff_lat") @db.DoublePrecision
  dropoffLng        Float?       @map("dropoff_lng") @db.DoublePrecision
  dropoffZone       String?      @map("dropoff_zone")
  dropoffDetails    String?      @map("dropoff_details")
  items             String?
  size              ParcelSize?
  priceUsd          Decimal?     @map("price_usd") @db.Decimal(8, 2)
  riderId           Int?         @map("rider_id")
  failReason        String?      @map("fail_reason")
  rating            Int?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  assignedAt        DateTime?    @map("assigned_at") @db.Timestamptz(6)
  pickedUpAt        DateTime?    @map("picked_up_at") @db.Timestamptz(6)
  finishedAt        DateTime?    @map("finished_at") @db.Timestamptz(6)
  recipientName     String?      @map("recipient_name")
  recipientPhone    String?      @map("recipient_phone")
  businessId        Int?         @map("business_id")
  businessLocationId Int?        @map("business_location_id")
  batchId           Int?         @map("batch_id")
  dropoffAreaId     Int?         @map("dropoff_area_id")
  codUsd            Decimal?     @map("cod_usd") @db.Decimal(10, 2)
  notes             String?
  settlementId      Int?         @map("settlement_id")
  codLbp            BigInt?      @map("cod_lbp")
  retryOfOrderId    Int?         @unique(map: "orders_retry_of_uq") @map("retry_of_order_id")
  collectedUsd      Decimal?     @map("collected_usd") @db.Decimal(10, 2)
  collectedLbp      BigInt?      @map("collected_lbp")
  riderPayPercent   Int?         @map("rider_pay_percent")
  riderPayUsd       Decimal?     @map("rider_pay_usd") @db.Decimal(8, 2)
  stepChangedAt     DateTime     @default(now()) @map("step_changed_at") @db.Timestamptz(6)
  cancelReason      CancelReason? @map("cancel_reason")
  cancelNote        String?      @map("cancel_note")
  riderLinkKey      String       @unique @map("rider_link_key")

  @@index([batchId], map: "orders_batch_idx")
  @@index([businessId, createdAt], map: "orders_business_idx")
  @@index([clientId], map: "orders_client_idx")
  @@unique([id, businessId], map: "orders_id_business_uq")
  @@unique([id, clientId], map: "orders_id_client_uq")
  @@index([riderId, status], map: "orders_rider_idx")
  @@index([status, createdAt], map: "orders_status_idx")
  @@map("orders")
}

model OrderEvent {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  type        String
  data        Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorUserId String?  @map("actor_user_id")

  @@index([orderId, createdAt], map: "order_events_order_idx")
  @@map("order_events")
}

model OrderForm {
  id          Int         @id @default(autoincrement())
  waId        String      @map("wa_id")
  service     ServiceType
  language    Language
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(6)
  submittedAt DateTime?   @map("submitted_at") @db.Timestamptz(6)
  tokenHash   String      @unique @map("token_hash")

  @@index([waId, createdAt], map: "order_forms_wa_id_idx")
  @@map("order_forms")
}


// ==========================================
// 6. RIDERS
// ==========================================


model Rider {
  id              Int       @id @default(autoincrement())
  name            String
  phone           String    @unique
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  telegramChatId  BigInt?   @unique @map("telegram_chat_id")
  telegramLinkedAt DateTime? @map("telegram_linked_at") @db.Timestamptz(6)
  language        Language  @default(ar)
  payPercent      Int       @default(80) @map("pay_percent")

  @@map("riders")
}

model RiderTelegramLink {
  riderId   Int       @map("rider_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  codeHash  String    @id @map("code_hash")

  @@map("rider_telegram_links")
}

model RiderShift {
  id             Int          @id @default(autoincrement())
  riderId        Int          @map("rider_id")
  startedAt      DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  startLat       Float        @map("start_lat") @db.DoublePrecision
  startLng       Float        @map("start_lng") @db.DoublePrecision
  endedAt        DateTime?    @map("ended_at") @db.Timestamptz(6)
  endLat         Float?       @map("end_lat") @db.DoublePrecision
  endLng         Float?       @map("end_lng") @db.DoublePrecision
  endedBy        ShiftEndedBy? @map("ended_by")
  endedByUserId  String?      @map("ended_by_user_id")
  liveSharedAt   DateTime?    @map("live_shared_at") @db.Timestamptz(6)
  liveUntil      DateTime?    @map("live_until") @db.Timestamptz(6)
  lastLat        Float?       @map("last_lat") @db.DoublePrecision
  lastLng        Float?       @map("last_lng") @db.DoublePrecision
  lastAccuracyM  Float?       @map("last_accuracy_m") @db.DoublePrecision
  lastAt         DateTime?    @map("last_at") @db.Timestamptz(6)

  @@unique([id, riderId], map: "rider_shifts_id_rider_uq")
  @@index([riderId, startedAt], map: "rider_shifts_rider_idx")
  @@map("rider_shifts")
}

model RiderLocation {
  id         BigInt   @id @default(autoincrement())
  riderId    Int      @map("rider_id")
  shiftId    Int      @map("shift_id")
  lat        Float    @db.DoublePrecision//north and south a geo loc is , use double precid=sion data type 
  lng        Float    @db.DoublePrecision// east and west
  accuracyM  Float?   @map("accuracy_m") @db.DoublePrecision
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(6)

  @@index([recordedAt], map: "rider_locations_recorded_idx")
  @@index([shiftId, recordedAt], map: "rider_locations_shift_idx")
  @@map("rider_locations")
}

model DeliveryProof {
  id            Int       @id @default(autoincrement())
  orderId       Int       @unique @map("order_id")
  riderId       Int?      @map("rider_id")
  kind          ProofKind //PICKUP_PHOTO: Photo proving the rider collected the package,
                          //DELIVERY_PHOTO: Photo proving the package was delivered.
                          //SIGNATURE: Recipient's signature.
                          //RECEIPT: Proof of payment or transaction.
  file          String?// where the proofkinf file is stored
  sha256        String // crypto hash algo
  bytes         Int
  takenAt       DateTime  @default(now()) @map("taken_at") @db.Timestamptz(6)
  deviceTime    DateTime? @map("device_time") @db.Timestamptz(6)
  lat           Float     @db.DoublePrecision
  lng           Float     @db.DoublePrecision
  accuracyM     Float?    @map("accuracy_m") @db.DoublePrecision//A smaller number means better GPS accuracy.
  distanceM     Int?      @map("distance_m")
  userAgent     String?   @map("user_agent")
  fileRemovedAt DateTime? @map("file_removed_at") @db.Timestamptz(6)

  @@map("delivery_proofs")
}

//==========================================
// 7. FINANCE AND SETTLEMENTS
// ==========================================


model BusinessSettlement {
  id              Int              @id @default(autoincrement())
  businessId      Int              @map("business_id")
  codUsd          Decimal          @map("cod_usd") @db.Decimal(12, 2)//12 = maximum total number of digits,2 = number of digits after the decimal point.
  feesUsd         Decimal          @map("fees_usd") @db.Decimal(12, 2)
  netUsd          Decimal          @map("net_usd") @db.Decimal(12, 2)
  method          SettlementMethod?
  note            String?
  createdByUserId String?          @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  codLbp          BigInt           @default(0) @map("cod_lbp")
  voidedAt        DateTime?        @map("voided_at") @db.Timestamptz(6)
  voidedByUserId  String?          @map("voided_by_user_id")

  @@unique([id, businessId], map: "business_settlements_id_business_uq")
  @@index([businessId, createdAt], map: "business_settlements_business_idx")
  @@map("business_settlements")
}

model RiderCashMovement {
  id               Int           @id @default(autoincrement())
  riderId          Int           @map("rider_id")
  direction        CashDirection
  usd              Decimal       @default(0) @db.Decimal(10, 2)
  lbp              BigInt        @default(0)
  note             String?
  recordedByUserId String?       @map("recorded_by_user_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt         DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidedByUserId   String?       @map("voided_by_user_id")
  idempotencyKey   String?       @unique(map: "rider_cash_movements_idempotency_key_key") @map("idempotency_key")

  @@index([riderId, createdAt], map: "rider_cash_movements_rider_idx")
  @@map("rider_cash_movements")
}

// ==========================================
// 8. AUDIT AND IMPORT
// ==========================================



model AuditLog {
  id           BigInt       @id @default(autoincrement())
  actorUserId  String?      @map("actor_user_id")
  actorName    String       @map("actor_name")
  action       String
  resourceType String       @map("resource_type")
  resourceId   String?      @map("resource_id")
  before       Json?        @db.JsonB
  after        Json?        @db.JsonB
  outcome      AuditOutcome @default(ok)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorUserId, createdAt], map: "audit_log_actor_idx")
  @@index([resourceType, resourceId, createdAt], map: "audit_log_resource_idx")
  @@map("audit_log")
}

model ImportRecord {
  id           Int          @id @default(autoincrement())
  source       String
  legacyId     String       @unique @map("legacy_id")
  clientId     Int?         @map("client_id")
  businessId   Int?         @map("business_id")
  savedAs      String?      @map("saved_as")
  phoneEditedOn DateTime?   @map("phone_edited_on") @db.Date
  issues       ImportIssue[] @default([])
  mergedSavedAs String[]    @default([]) @map("merged_saved_as")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([businessId], map: "import_records_business_idx")
  @@index([clientId], map: "import_records_client_idx")
  @@map("import_records")
}

// ==========================================
// 9. WHATSAPP AND TELEGRAM
// ==========================================



model WaMessage {
  id          Int       @id @default(autoincrement())
  wamid       String    @unique
  direction   String
  waId        String    @map("wa_id")
  type        String
  payload     Json      @db.JsonB//store structured objects(action.orderid,success,notes)
                                 // jsonB(best choice) POSTGRESQL database type
  status      String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([waId, createdAt], map: "wa_messages_wa_id_idx")
  @@map("wa_messages")
}


model TgUpdate {//telegram Bot API updates
  updateId    BigInt    @id @map("update_id")
  payload     Json      @db.JsonB// stores the complete tel;egram update as json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@map("tg_updates")//Maps the Prisma model to the PostgreSQL table
}




model TgOrderMessage {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  riderId   Int      @map("rider_id")
  chatId    BigInt   @map("chat_id")
  messageId BigInt   @map("message_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId], map: "tg_order_messages_order_idx")
  @@map("tg_order_messages")
}



model StaffTelegram {
  userId   String   @id @map("user_id")
  chatId   BigInt   @unique @map("chat_id")
  linkedAt DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)

  @@map("staff_telegram")
}

model StaffTelegramLink {
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  codeHash  String    @id @map("code_hash")

  @@map("staff_telegram_links")
}

// ==========================================
// 10. STAFF SHIFTS AND ALERTS
// ==========================================


model StaffShift {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  endedByUserId  String?   @map("ended_by_user_id")//An administrator closes a customer conversation.
                                                   //A dispatcher ends an active order-handling session.
                                                   //A staff member terminates a workflow.
  remindedAt     DateTime? @map("reminded_at") @db.Timestamptz(6)

  @@index([userId, startedAt], map: "staff_shifts_user_idx")
  @@map("staff_shifts")
}

model AlertLog {
  key    String   @id
  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@map("alert_log")
}

model ProofFileToRemove {
  file      String   @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("proof_files_to_remove")
}
